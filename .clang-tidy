# clang-tidy configuration.
# Mirrors the curated check selection from the global clangd config
# (~/.config/clangd/config.yaml)
# Read by both clangd (merged with the global ClangTidy Add/Remove lists) and
# the clang-tidy CLI. clangd drops the clang-analyzer-* checks from its registry
# ("check not found"), so they only fire when clang-tidy runs from the CLI; they
# are listed anyway so CLI runs get the full curated set. The analyzer entries
# are the quiet, high-value subset (null derefs, leaks, UB, buffer overflows);
# the noisy alpha ones (UninitializedObject, UnreachableCode, ArrayBound) are
# deliberately excluded.
# bugprone-throwing-static-initialization is excluded: it flags const
# QStringLiteral(...) file-scope constants even though QStringLiteral is
# non-allocating and cannot throw (the check cannot see through the macro).
# Excluded rather than NOLINT'ed at 60+ sites.
# bugprone-invalid-enum-default-initialization is excluded: it fires on Qt
# moc-generated QMetaObject::MetaObjectFlag zero-init in build/*_autogen/*.moc
# (moc emits 0 even though the enum has no zero enumerator).
Checks: >-
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-narrowing-conversions,
  -bugprone-swapped-arguments,
  -bugprone-throwing-static-initialization,
  -bugprone-invalid-enum-default-initialization,
  cert-dcl50-cpp,
  cert-env33-c,
  cert-err61-cpp,
  cert-mem57-cpp,
  cert-oop54-cpp,
  cert-oop57-cpp,
  cert-oop58-cpp,
  cppcoreguidelines-avoid-goto,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  clang-analyzer-core.BoolAssignment,
  clang-analyzer-core.CallAndMessage,
  clang-analyzer-core.DivideZero,
  clang-analyzer-core.NonNullParamChecker,
  clang-analyzer-core.NullDereference,
  clang-analyzer-core.StackAddressEscape,
  clang-analyzer-core.UndefinedBinaryOperatorResult,
  clang-analyzer-core.uninitialized.ArraySubscript,
  clang-analyzer-core.uninitialized.Assign,
  clang-analyzer-core.uninitialized.Branch,
  clang-analyzer-core.uninitialized.UndefReturn,
  clang-analyzer-core.uninitialized.VlaSize,
  clang-analyzer-cplusplus.InnerPointer,
  clang-analyzer-cplusplus.Move,
  clang-analyzer-cplusplus.NewDeleteLeaks,
  clang-analyzer-cplusplus.SelfAssignment,
  clang-analyzer-cplusplus.SmartPtr,
  clang-analyzer-cplusplus.StringChecker,
  clang-analyzer-deadcode.DeadStores,
  clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  clang-analyzer-security.insecureAPI.strcpy,
  clang-analyzer-security.insecureAPI.strlen,
  clang-analyzer-unix.API,
  clang-analyzer-unix.Malloc,
  clang-analyzer-unix.MallocSizeof,
  clang-analyzer-unix.MismatchedDeallocator,
  clang-analyzer-unix.cstring.BadSizeArg,
  clang-analyzer-unix.cstring.NullArg,
  clang-analyzer-valist.CopyToSelf,
  clang-analyzer-valist.Uninitialized,
  clang-analyzer-valist.Unterminated,
  clang-analyzer-alpha.core.CastSize,
  clang-analyzer-alpha.core.IdenticalExpr,
  clang-analyzer-alpha.cplusplus.DeleteWithNonVirtualDtor,
  clang-analyzer-alpha.cplusplus.EnumCastOutOfRange,
  clang-analyzer-alpha.security.ArrayBoundV2,
  clang-analyzer-alpha.security.MallocOverflow,
  misc-include-cleaner,
  misc-unused-parameters,
  misc-unused-using-decls,
  misc-unused-alias-decls,
  misc-definitions-in-headers,
  misc-static-assert,
  misc-throw-by-value-catch-by-reference,
  misc-redundant-expression,
  misc-confusable-identifiers,
  misc-misleading-identifier,
  misc-non-copyable-objects,
  misc-unconventional-assign-operator,
  misc-new-delete-overloads,
  misc-predictable-rand,
  misc-header-include-cycle,
  misc-coroutine-hostile-raii,
  misc-anonymous-namespace-in-header,
  misc-misleading-bidirectional,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-pass-by-value,
  modernize-loop-convert,
  modernize-avoid-c-arrays,
  modernize-deprecated-headers,
  modernize-make-unique,
  modernize-make-shared,
  modernize-use-default-member-init,
  modernize-use-emplace,
  modernize-use-using,
  modernize-use-bool-literals,
  modernize-redundant-void-arg,
  performance-*,
  -performance-implicit-conversion-in-loop,
  readability-identifier-naming,
  readability-simplify-boolean-expr,
  readability-else-after-return,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  readability-redundant-smartptr-get,
  readability-redundant-string-cstr,
  readability-redundant-string-init,
  readability-redundant-member-init,
  readability-redundant-preprocessor,
  readability-non-const-parameter,
  readability-container-size-empty,
  readability-qualified-auto,
  readability-static-accessed-through-instance,
  readability-misleading-indentation,
  readability-suspicious-call-argument,
  readability-avoid-const-params-in-decls,
  readability-const-return-type,
  readability-isolate-declaration,
  readability-redundant-access-specifiers,
  readability-inconsistent-declaration-parameter-name,
  readability-duplicate-include,
  readability-string-compare,
  readability-simplify-subscript-expr
CheckOptions:
  misc-include-cleaner.UnusedIncludes: true
  misc-include-cleaner.MissingIncludes: false
